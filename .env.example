# Firebase
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# OpenAI
VITE_OPENAI_API_KEY=sk-your-openai-api-key

# Spotify
VITE_SPOTIFY_CLIENT_ID=your-spotify-client-id
VITE_SPOTIFY_REDIRECT_URI=http://localhost:3000/callback/spotify

# Apple Music (MusicKit)
VITE_APPLE_MUSIC_TOKEN=your-apple-music-developer-token

# YouTube
VITE_YOUTUBE_API_KEY=your-youtube-api-key
VITE_YOUTUBE_CLIENT_ID=your-youtube-client-id

# Stripe
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
VITE_STRIPE_PRICE_ID=price_your-monthly-subscription-price-id
